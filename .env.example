# ==============================================================================
# Sungrow Battery Balancer Environment Configuration Example
# ==============================================================================

# InfluxDB 1.8.x Configuration (Required)
INFLUXDB_URL=https://influxdb.example.com:8086
INFLUXDB_USER=pv-monitoring-user
INFLUXDB_PASSWORD=your_influx_password_here
INFLUXDB_DB=pv_monitoring
INFLUXDB_QUERY="SELECT MAX(last_battery_level) FROM (SELECT last(battery_level) as last_battery_level FROM sungather GROUP BY serial fill(previous))"
INFLUXDB_VERIFY_SSL=true

# Sungrow Inverter Modbus TCP Configuration (Required)
# Comma-separated list of IP:PORT pairs
INVERTER_HOSTS=192.168.1.100:502,192.168.1.101:502
MODBUS_SLAVE_ID=1
MODBUS_REGISTER=33047
MODBUS_REGISTER_OFFSET=-1
MODBUS_TIMEOUT=5.0

# Grafana Annotation Configuration (Required)
GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=your_grafana_service_account_token_here
GRAFANA_DASHBOARD_UID=your_dashboard_uid_here
GRAFANA_PANEL_ID=1

# Thresholds & Power Settings (Optional / Defaults provided)
HIGH_SOC_THRESHOLD=85.0
LOW_SOC_THRESHOLD=80.0
FULL_SOC_THRESHOLD=100.0
REDUCED_CHARGING_POWER=1.0
MAX_CHARGING_POWER=10.6

# Operational Settings (Optional)
CHECK_INTERVAL=60
LOG_LEVEL=INFO
DRY_RUN=false
